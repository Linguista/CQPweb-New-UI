+/* cqpweb-new-ui: CQPweb shows its account-activation screens only to visitors who are not logged in. Someone who
+ * is logged in when they open an activation link (an administrator trying out a new account, for example) got
+ * "Sorry, but that is not a valid menu option" instead, although the account had been activated. They now get the
+ * result as a message on their own account page. */
+if ('verifyUser' == $script_action && isset($next_location) && $User->logged_in
+	&& preg_match('/verifyScreenType=(\w+)/', $next_location, $verify_m))
+{
+	$verify_msg = [
+		'success' => "The account '" . ($the_username ?? '') . "' has been activated. You are still logged in as '{$User->username}'; log out to log in with the new account.",
+		'already' => 'That account had already been activated.',
+		'failure' => 'The account could not be activated: its activation key was not found. Log out, then ask for a new activation e-mail.',
+		'badlink' => 'The activation link could not be read. Log out, then enter the activation key by hand.',
+	][$verify_m[1]] ?? null;
+	if (null !== $verify_msg)
+		$next_location = 'index.php?ui=welcome&extraMsg=' . urlencode($verify_msg);
+}
+
